# Copie para docker/.env (arquivo ignorado pelo Git) e preencha. Nunca versione valores reais.

# Senha do usuário sa do SQL Server: mínimo 8 caracteres com maiúscula, minúscula, número e símbolo.
SA_PASSWORD=

# Segredo de assinatura do JWT: texto aleatório com 32 caracteres ou mais.
JWT_KEY=

# Senha do administrador inicial (admin@aurora.local), criado só se o banco não tiver usuários.
SEED_ADMIN_PASSWORD=

# Opcional: ligue o Swagger (/swagger) apenas no ambiente local.
# SWAGGER_HABILITADO=true
