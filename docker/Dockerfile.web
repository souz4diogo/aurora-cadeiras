# Build com o contexto na raiz do repositório: docker build -f docker/Dockerfile.web .

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /repo
COPY Directory.Build.props .editorconfig ./
COPY src/ src/
RUN dotnet publish src/Aurora.Web/Aurora.Web.csproj -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
# O painel exibe e lê números e datas em pt-BR: sem o pacote de dados completo, o Alpine só tem o inglês
RUN apk add --no-cache icu-libs icu-data-full
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_HTTP_PORTS=8080
WORKDIR /app
COPY --from=build /app .
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:8080/health >/dev/null || exit 1
ENTRYPOINT ["dotnet", "Aurora.Web.dll"]
