@model UsuariosListaViewModel
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a class="btn btn-primary" asp-action="Novo">Novo usuário</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3" role="search" aria-label="Buscar usuários">
    <div class="col-12 col-md-6">
        <label for="busca" class="form-label">Nome ou e-mail</label>
        <input id="busca" name="busca" class="form-control" value="@Model.Busca" autocomplete="off" />
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

@if (Model.Pagina.Items.Count == 0)
{
    <p class="alert alert-info" role="status">Nenhum usuário encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Lista de usuários</caption>
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Perfil</th>
                    <th scope="col">Último acesso</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model.Pagina.Items)
                {
                    <tr>
                        <th scope="row">@usuario.Nome</th>
                        <td>@usuario.Email</td>
                        <td>@Formatacao.NomeDoPerfil(usuario.Perfil)</td>
                        <td>@(usuario.UltimoLoginEm is DateTime acesso ? Formatacao.DataHora(acesso) : "Nunca entrou")</td>
                        <td><partial name="_Situacao" model="usuario.Ativo" /></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@usuario.Id">Editar<span class="visually-hidden"> @usuario.Nome</span></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="RedefinirSenha" asp-route-id="@usuario.Id">Redefinir senha<span class="visually-hidden"> de @usuario.Nome</span></a>
                            <partial name="_AlternarSituacao" model="new AlternarSituacaoViewModel(usuario.Id, usuario.Nome, usuario.Ativo)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacao" model="new PaginacaoViewModel(Model.Pagina.Page, Model.Pagina.TotalDePaginas, Model.Pagina.Total)" />
}
