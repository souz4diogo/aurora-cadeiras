@model PedidoCompraFormViewModel
@{
    ViewData["Title"] = "Novo pedido de compra";

    // Valor como o usuário digitou, para não perder o texto quando o formulário volta com erro
    string Tentado(string nome, string padrao) =>
        ViewContext.ModelState.TryGetValue(nome, out var entrada) && entrada?.AttemptedValue is not null ? entrada.AttemptedValue : padrao;

    async Task Linha(string indice, CompraItemFormViewModel? item)
    {
        var quantidade = item is null ? "" : Tentado($"Itens[{indice}].Quantidade", item.Quantidade is decimal q ? Formatacao.Quantidade(q) : "");
        var custo = item is null ? "" : Tentado($"Itens[{indice}].CustoUnitario", item.CustoUnitario is decimal c ? Formatacao.Quantidade(c) : "");
        <tr data-linha>
            <td>
                <label class="visually-hidden" for="Itens_@(indice)__MateriaPrimaId">Matéria-prima da linha</label>
                <select id="Itens_@(indice)__MateriaPrimaId" name="Itens[@indice].MateriaPrimaId" class="form-select">
                    <option value="">Escolha a matéria-prima</option>
                    @foreach (var materia in Model.MateriasPrimas)
                    {
                        <option value="@materia.Value" selected="@(item?.MateriaPrimaId?.ToString(System.Globalization.CultureInfo.InvariantCulture) == materia.Value)">@materia.Text</option>
                    }
                </select>
                @Html.ValidationMessage($"Itens[{indice}].MateriaPrimaId", null, new { @class = "text-danger" })
            </td>
            <td>
                <label class="visually-hidden" for="Itens_@(indice)__Quantidade">Quantidade da linha</label>
                <input id="Itens_@(indice)__Quantidade" name="Itens[@indice].Quantidade" type="text" inputmode="decimal" autocomplete="off"
                       class="form-control numero" value="@quantidade" />
                @Html.ValidationMessage($"Itens[{indice}].Quantidade", null, new { @class = "text-danger" })
            </td>
            <td>
                <label class="visually-hidden" for="Itens_@(indice)__CustoUnitario">Custo unitário da linha (opcional)</label>
                <input id="Itens_@(indice)__CustoUnitario" name="Itens[@indice].CustoUnitario" type="text" inputmode="decimal" autocomplete="off"
                       class="form-control numero" value="@custo" placeholder="Custo atual" />
                @Html.ValidationMessage($"Itens[{indice}].CustoUnitario", null, new { @class = "text-danger" })
            </td>
            <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-danger" data-remover-linha>Remover<span class="visually-hidden"> este item</span></button>
            </td>
        </tr>
    }
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="Novo" method="post" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div>

    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="mb-3">
                <label asp-for="FornecedorId" class="form-label"></label>
                <select asp-for="FornecedorId" asp-items="Model.Fornecedores" class="form-select" aria-describedby="FornecedorId-erro">
                    <option value="">Escolha o fornecedor</option>
                </select>
                <span asp-validation-for="FornecedorId" id="FornecedorId-erro" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-3"><aurora-campo for="DataPrevista" tipo="date" dica="Opcional." /></div>
    </div>

    <h2 class="h5">Itens do pedido de compra</h2>
    <p id="ajuda-itens" class="text-muted">
        Deixe o custo em branco para usar o custo atual da matéria-prima. O pedido nasce como solicitado e só vai ao
        fornecedor quando for emitido.
    </p>

    <div class="table-responsive">
        <table class="table align-middle" aria-describedby="ajuda-itens">
            <caption class="visually-hidden">Itens do pedido de compra</caption>
            <thead>
                <tr>
                    <th scope="col">Matéria-prima</th>
                    <th scope="col" class="numero">Quantidade</th>
                    <th scope="col" class="numero">Custo unitário (R$)</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody data-linhas data-prefixo="Itens">
                @for (var i = 0; i < Model.Itens.Count; i++)
                {
                    await Linha(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Itens[i]);
                }
            </tbody>
            <template data-modelo>
                @{ await Linha("__INDICE__", null); }
            </template>
        </table>
    </div>

    <div id="anuncio-linhas" class="visually-hidden" aria-live="polite" role="status"></div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button type="button" class="btn btn-outline-primary" data-adicionar-linha>Adicionar item</button>
    </div>

    <button type="submit" class="btn btn-primary">Criar pedido de compra</button>
    <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <script src="~/js/linhas-dinamicas.js" asp-append-version="true"></script>
}
