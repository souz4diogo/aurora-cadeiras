@model PedidosListaViewModel
@{
    ViewData["Title"] = "Pedidos";
    var podeCriar = User.IsInRole(Perfis.Administrador) || User.IsInRole(Perfis.Vendedor);
    var filtro = Model.Filtro;
    string[] statusPossiveis = ["Aberto", "Confirmado", "EmProducao", "Pronto", "Expedido", "Cancelado"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Pedidos</h1>
    @if (podeCriar)
    {
        <a class="btn btn-primary" asp-action="Novo">Novo pedido</a>
    }
</div>

<form method="get" class="row g-2 align-items-end mb-3" role="search" aria-label="Filtrar pedidos">
    <div class="col-12 col-md-3 col-lg-2">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select">
            <option value="">Todos</option>
            @foreach (var status in statusPossiveis)
            {
                <option value="@status" selected="@(filtro.Status == status)">@Formatacao.StatusDoPedido(status)</option>
            }
        </select>
    </div>
    @if (Model.Clientes is not null)
    {
        <div class="col-12 col-md-4 col-lg-3">
            <label for="clienteId" class="form-label">Cliente</label>
            <select id="clienteId" name="clienteId" class="form-select">
                <option value="">Todos</option>
                @foreach (var cliente in Model.Clientes)
                {
                    <option value="@cliente.Value" selected="@(filtro.ClienteId?.ToString(System.Globalization.CultureInfo.InvariantCulture) == cliente.Value)">@cliente.Text</option>
                }
            </select>
        </div>
    }
    <div class="col-6 col-md-2">
        <label for="de" class="form-label">Pedidos de</label>
        <input id="de" name="de" type="date" class="form-control" value="@filtro.De?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-2">
        <label for="ate" class="form-label">até</label>
        <input id="ate" name="ate" type="date" class="form-control" value="@filtro.Ate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-3 col-lg-2">
        <label for="atrasados" class="form-label">Prazo</label>
        <select id="atrasados" name="atrasados" class="form-select">
            <option value="" selected="@(filtro.Atrasados is null)">Todos</option>
            <option value="true" selected="@(filtro.Atrasados == true)">Somente atrasados</option>
            <option value="false" selected="@(filtro.Atrasados == false)">Em dia</option>
        </select>
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
</form>

@if (Model.Pagina.Items.Count == 0)
{
    <p class="alert alert-info" role="status">Nenhum pedido encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Lista de pedidos, do mais recente ao mais antigo</caption>
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Data</th>
                    <th scope="col">Prazo de entrega</th>
                    <th scope="col" class="numero">Itens</th>
                    <th scope="col" class="numero">Valor total</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.Pagina.Items)
                {
                    <tr>
                        <th scope="row"><a asp-action="Detalhes" asp-route-id="@pedido.Id">@pedido.Numero</a></th>
                        <td>@pedido.ClienteNome</td>
                        <td>@Formatacao.DataHora(pedido.DataPedido)</td>
                        <td>
                            @Formatacao.Data(pedido.PrazoEntrega)
                            @if (pedido.Atrasado)
                            {
                                <span class="badge text-bg-warning">Atrasado</span>
                            }
                        </td>
                        <td class="numero">@pedido.QuantidadeItens</td>
                        <td class="numero">@Formatacao.Moeda(pedido.ValorTotal)</td>
                        <td><partial name="_StatusDoPedido" model="pedido.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacao" model="new PaginacaoViewModel(Model.Pagina.Page, Model.Pagina.TotalDePaginas, Model.Pagina.Total)" />
}
