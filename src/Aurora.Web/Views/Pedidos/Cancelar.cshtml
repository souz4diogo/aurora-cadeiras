@model PedidoResposta
@{
    ViewData["Title"] = "Cancelar pedido " + Model.Numero;
}

<h1 class="h3 mb-3">Cancelar pedido @Model.Numero?</h1>

<div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div>

<p>
    O pedido de <strong>@Model.ClienteNome</strong>, no valor de <strong>@Formatacao.Moeda(Model.ValorTotal)</strong>,
    será cancelado. As reservas de estoque são liberadas e as ordens de produção em aberto são canceladas.
    Esta ação não pode ser desfeita.
</p>

<form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Sim, cancelar o pedido</button>
    <a class="btn btn-outline-secondary" asp-action="Detalhes" asp-route-id="@Model.Id">Não, voltar</a>
</form>
