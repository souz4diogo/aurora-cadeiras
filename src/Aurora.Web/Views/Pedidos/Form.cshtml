@model PedidoFormViewModel
@{
    var edicao = Model.Id is not null;
    ViewData["Title"] = edicao ? "Editar pedido " + Model.Numero : "Novo pedido";

    // Quantidade como o usuário digitou, para não perder o texto quando o formulário volta com erro
    string Tentado(string nome, string padrao) =>
        ViewContext.ModelState.TryGetValue(nome, out var entrada) && entrada?.AttemptedValue is not null ? entrada.AttemptedValue : padrao;

    async Task Linha(string indice, PedidoItemFormViewModel? item)
    {
        var quantidade = item is null ? "1" : Tentado($"Itens[{indice}].Quantidade", item.Quantidade.ToString(System.Globalization.CultureInfo.InvariantCulture));
        <tr data-linha>
            <td>
                <label class="visually-hidden" for="Itens_@(indice)__ProdutoId">Produto da linha</label>
                <select id="Itens_@(indice)__ProdutoId" name="Itens[@indice].ProdutoId" class="form-select">
                    <option value="">Escolha o produto</option>
                    @foreach (var produto in Model.Produtos)
                    {
                        <option value="@produto.Id" data-preco="@produto.Preco.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                selected="@(item?.ProdutoId == produto.Id)">@produto.Rotulo (@Formatacao.Moeda(produto.Preco))</option>
                    }
                </select>
                @Html.ValidationMessage($"Itens[{indice}].ProdutoId", null, new { @class = "text-danger" })
            </td>
            <td>
                <label class="visually-hidden" for="Itens_@(indice)__Quantidade">Quantidade da linha</label>
                <input id="Itens_@(indice)__Quantidade" name="Itens[@indice].Quantidade" type="number" min="1" max="100000" step="1"
                       class="form-control numero" value="@quantidade" />
                @Html.ValidationMessage($"Itens[{indice}].Quantidade", null, new { @class = "text-danger" })
            </td>
            <td class="numero" data-subtotal>R$ 0,00</td>
            <td class="text-end">
                <button type="button" class="btn btn-sm btn-outline-danger" data-remover-linha>Remover<span class="visually-hidden"> este item</span></button>
            </td>
        </tr>
    }
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<form asp-action="@(edicao ? "Editar" : "Novo")" asp-route-id="@Model.Id" method="post" novalidate>
    <input type="hidden" asp-for="Numero" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert" tabindex="-1"></div>

    <div class="row">
        <div class="col-12 col-lg-5">
            <div class="mb-3">
                <label asp-for="ClienteId" class="form-label"></label>
                <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select" aria-describedby="ClienteId-erro">
                    <option value="">Escolha o cliente</option>
                </select>
                <span asp-validation-for="ClienteId" id="ClienteId-erro" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-lg-3"><aurora-campo for="PrazoEntrega" tipo="date" /></div>
        <div class="col-12 col-lg-12"><aurora-campo for="Observacao" tamanho-maximo="300" autocomplete="off" /></div>
    </div>

    <h2 class="h5">Itens do pedido</h2>
    <p id="ajuda-itens" class="text-muted">
        O preço de cada item é o preço de venda do produto no momento em que ele entra no pedido. Itens que já estavam no
        pedido mantêm o preço gravado; o total abaixo é uma estimativa com os preços atuais.
    </p>

    <div class="table-responsive">
        <table class="table align-middle" aria-describedby="ajuda-itens">
            <caption class="visually-hidden">Itens do pedido</caption>
            <thead>
                <tr>
                    <th scope="col">Produto</th>
                    <th scope="col" class="numero">Quantidade</th>
                    <th scope="col" class="numero">Subtotal estimado</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody data-linhas data-prefixo="Itens">
                @for (var i = 0; i < Model.Itens.Count; i++)
                {
                    await Linha(i.ToString(System.Globalization.CultureInfo.InvariantCulture), Model.Itens[i]);
                }
            </tbody>
            <template data-modelo>
                @{ await Linha("__INDICE__", null); }
            </template>
            <tfoot>
                <tr>
                    <th scope="row" colspan="2" class="numero">Total estimado</th>
                    <td class="numero"><output id="total-pedido" aria-live="polite">R$ 0,00</output></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div id="anuncio-linhas" class="visually-hidden" aria-live="polite" role="status"></div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <button type="button" class="btn btn-outline-primary" data-adicionar-linha>Adicionar item</button>
    </div>

    <button type="submit" class="btn btn-primary">Salvar pedido</button>
    <a class="btn btn-link" asp-action="@(edicao ? "Detalhes" : "Index")" asp-route-id="@Model.Id">Cancelar</a>
</form>

@section Scripts {
    <script src="~/js/linhas-dinamicas.js" asp-append-version="true"></script>
    <script src="~/js/total-do-pedido.js" asp-append-version="true"></script>
}
