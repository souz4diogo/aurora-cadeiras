@model FornecedoresListaViewModel
@{
    ViewData["Title"] = "Fornecedores";
    var podeEditar = User.IsInRole(Perfis.Administrador) || User.IsInRole(Perfis.Almoxarife);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Fornecedores</h1>
    @if (podeEditar)
    {
        <a class="btn btn-primary" asp-action="Novo">Novo fornecedor</a>
    }
</div>

<form method="get" class="row g-2 align-items-end mb-3" role="search" aria-label="Filtrar fornecedores">
    <div class="col-12 col-md-4">
        <label for="busca" class="form-label">Razão social ou CNPJ</label>
        <input id="busca" name="busca" class="form-control" value="@Model.Busca" />
    </div>
    <div class="col-12 col-md-3">
        <partial name="_FiltroDeSituacao" model="Model.Ativo" />
    </div>
    <div class="col-12 col-md-3">
        <label for="comunidadeTradicional" class="form-label">Comunidade tradicional</label>
        <select id="comunidadeTradicional" name="comunidadeTradicional" class="form-select">
            <option value="" selected="@(Model.ComunidadeTradicional is null)">Todos</option>
            <option value="true" selected="@(Model.ComunidadeTradicional == true)">Somente comunidades tradicionais</option>
            <option value="false" selected="@(Model.ComunidadeTradicional == false)">Demais fornecedores</option>
        </select>
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
</form>

@if (Model.Pagina.Items.Count == 0)
{
    <p class="alert alert-info" role="status">Nenhum fornecedor encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Lista de fornecedores</caption>
            <thead>
                <tr>
                    <th scope="col">Razão social</th>
                    <th scope="col">CNPJ</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Comunidade tradicional</th>
                    <th scope="col">Situação</th>
                    @if (podeEditar)
                    {
                        <th scope="col">Ações</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var fornecedor in Model.Pagina.Items)
                {
                    <tr>
                        <th scope="row">@fornecedor.RazaoSocial</th>
                        <td>@Formatacao.Documento(fornecedor.Cnpj)</td>
                        <td>@fornecedor.Email</td>
                        <td>@(fornecedor.ComunidadeTradicional ? "Sim" : "Não")</td>
                        <td><partial name="_Situacao" model="fornecedor.Ativo" /></td>
                        @if (podeEditar)
                        {
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@fornecedor.Id">Editar<span class="visually-hidden"> @fornecedor.RazaoSocial</span></a>
                                <partial name="_AlternarSituacao" model="new AlternarSituacaoViewModel(fornecedor.Id, fornecedor.RazaoSocial, fornecedor.Ativo)" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacao" model="new PaginacaoViewModel(Model.Pagina.Page, Model.Pagina.TotalDePaginas, Model.Pagina.Total)" />
}
