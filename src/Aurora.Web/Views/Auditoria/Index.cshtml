@model AuditoriaViewModel
@{
    ViewData["Title"] = "Auditoria";
    var filtro = Model.Filtro;
}

<h1 class="h3 mb-3">Auditoria</h1>

<p class="text-muted">
    Histórico de alterações de pedidos, ordens de produção, matérias-primas e usuários. Cada linha mostra quem fez a
    alteração, quando e quais campos mudaram. Senhas nunca são gravadas aqui.
</p>

<form method="get" class="row g-2 align-items-end mb-3" role="search" aria-label="Filtrar o histórico">
    <div class="col-12 col-md-3 col-lg-2">
        <label for="tabela" class="form-label">Tabela</label>
        <select id="tabela" name="tabela" class="form-select">
            <option value="">Todas</option>
            @foreach (var tabela in Model.Tabelas)
            {
                <option value="@tabela" selected="@(filtro.Tabela == tabela)">@tabela</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
        <label for="registro" class="form-label">Registro (chave)</label>
        <input id="registro" name="registro" type="text" inputmode="numeric" maxlength="50" autocomplete="off"
               class="form-control" value="@filtro.Registro" />
    </div>
    <div class="col-6 col-md-3 col-lg-3">
        <label for="usuarioId" class="form-label">Usuário</label>
        <select id="usuarioId" name="usuarioId" class="form-select">
            <option value="">Todos</option>
            @foreach (var usuario in Model.Usuarios)
            {
                <option value="@usuario.Value" selected="@(filtro.UsuarioId?.ToString(System.Globalization.CultureInfo.InvariantCulture) == usuario.Value)">@usuario.Text</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label for="de" class="form-label">De</label>
        <input id="de" name="de" type="date" class="form-control" value="@filtro.De?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-2">
        <label for="ate" class="form-label">Até</label>
        <input id="ate" name="ate" type="date" class="form-control" value="@filtro.Ate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
    </div>
</form>

@if (Model.Pagina.Items.Count == 0)
{
    <p class="alert alert-info" role="status">Nenhuma alteração encontrada para esses filtros.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <caption class="visually-hidden">Alterações registradas, da mais recente à mais antiga</caption>
            <thead>
                <tr>
                    <th scope="col">Quando</th>
                    <th scope="col">Tabela</th>
                    <th scope="col">Registro</th>
                    <th scope="col">Ação</th>
                    <th scope="col">Usuário</th>
                    <th scope="col">O que mudou</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linha in Model.Pagina.Items)
                {
                    <tr>
                        <td>@Formatacao.DataHora(linha.DataHora)</td>
                        <td>@linha.Tabela</td>
                        <td>@linha.Registro</td>
                        <td><span class="badge @(linha.Acao == "Exclusão" ? "text-bg-danger" : linha.Acao == "Inclusão" ? "text-bg-success" : "text-bg-secondary")">@linha.Acao</span></td>
                        <td>@(linha.UsuarioNome ?? "Fora da API")</td>
                        <td>
                            @if (linha.Alteracoes.Count == 0)
                            {
                                <span class="text-muted">Sem detalhes</span>
                            }
                            else
                            {
                                <details>
                                    <summary>@linha.Alteracoes.Count @(linha.Alteracoes.Count == 1 ? "campo" : "campos")<span class="visually-hidden"> do registro @linha.Registro de @linha.Tabela</span></summary>
                                    <table class="table table-sm mb-0 mt-2">
                                        <caption class="visually-hidden">Campos de @linha.Tabela @linha.Registro</caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">Campo</th>
                                                <th scope="col">Antes</th>
                                                <th scope="col">Depois</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var campo in linha.Alteracoes)
                                            {
                                                <tr>
                                                    <th scope="row">@campo.Campo</th>
                                                    <td>@(campo.Antes ?? "—")</td>
                                                    <td>@(campo.Depois ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacao" model="new PaginacaoViewModel(Model.Pagina.Page, Model.Pagina.TotalDePaginas, Model.Pagina.Total)" />
}
