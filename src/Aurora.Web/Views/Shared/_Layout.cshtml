@{
    var itensDoMenu = MenuPrincipal.Para(User);
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var perfil = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aurora Cadeiras</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-aurora" aria-label="Principal">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Aurora Cadeiras</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-principal"
                            aria-controls="menu-principal" aria-expanded="false" aria-label="Abrir ou fechar o menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menu-principal">
                        <ul class="navbar-nav me-auto">
                            @foreach (var item in itensDoMenu)
                            {
                                var atual = string.Equals(item.Controller, controllerAtual, StringComparison.Ordinal);
                                <li class="nav-item">
                                    <a class="nav-link @(atual ? "active" : "")" asp-controller="@item.Controller" asp-action="Index"
                                       aria-current="@(atual ? "page" : null)">@item.Titulo</a>
                                </li>
                            }
                        </ul>
                        <form class="d-flex align-items-center gap-3" asp-controller="Conta" asp-action="Logout" method="post">
                            <span class="navbar-text text-white">@User.Identity.Name <span class="text-white-50">(@perfil)</span></span>
                            <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                        </form>
                    </div>
                }
            </div>
        </nav>
    </header>

    <main id="conteudo" class="container py-4" tabindex="-1">
        <partial name="_Alertas" />
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted">
        <div class="container">&copy; 2026 Aurora Cadeiras &middot; projeto acadêmico (PIM IV, UNIP)</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
