@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="h3">Algo deu errado</h1>
<p>Não foi possível concluir esta ação. Tente novamente; se o problema continuar, avise o suporte.</p>

@if (Model.ShowRequestId)
{
    <p class="text-muted small">Código do atendimento: <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Voltar ao início</a>
